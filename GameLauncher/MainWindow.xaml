<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        mc:Ignorable="d"
        Title="Игровой Лаунчер" Height="680" Width="1024"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <Window.Resources>
        <!-- Style for Play Button with Asset States -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="360"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GlowBorder" CornerRadius="8">
                            <Grid>
                                <!-- Normal Image -->
                                <Image x:Name="NormalImage" Source="pack://application:,,,/Assets/Buttons/play_normal.png" Stretch="Fill"/>
                                <!-- Hover Image (hidden by default) -->
                                <Image x:Name="HoverImage" Source="pack://application:,,,/Assets/Buttons/play_hover.png" Stretch="Fill" Opacity="0"/>
                                <!-- Pressed Image (hidden by default) -->
                                <Image x:Name="PressedImage" Source="pack://application:,,,/Assets/Buttons/play_pressed.png" Stretch="Fill" Opacity="0"/>
                                <!-- Disabled Image (hidden by default) -->
                                <Image x:Name="DisabledImage" Source="pack://application:,,,/Assets/Buttons/play_disabled.png" Stretch="Fill" Opacity="0"/>

                                <!-- Button Content (Text or Icon overlay) -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverImage" Property="Opacity" Value="1"/>
                                <Setter TargetName="NormalImage" Property="Opacity" Value="0"/>
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00B0FF" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedImage" Property="Opacity" Value="1"/>
                                <Setter TargetName="NormalImage" Property="Opacity" Value="0"/>
                                <Setter TargetName="HoverImage" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DisabledImage" Property="Opacity" Value="1"/>
                                <Setter TargetName="NormalImage" Property="Opacity" Value="0"/>
                                <Setter TargetName="HoverImage" Property="Opacity" Value="0"/>
                                <Setter TargetName="PressedImage" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Secondary Buttons -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GlowBorder" CornerRadius="6">
                            <Border x:Name="ButtonBorder" Background="#CC333333" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CC555555"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00B0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CC222222"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Image & Dark Overlay -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/Backgrounds/launcher_background.png" Stretch="UniformToFill"/>
        </Grid.Background>
        
        <!-- Dark semi-transparent overlay to ensure readability -->
        <Rectangle Fill="#99000000"/>

        <!-- Main Layout Grid -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar: Logo & Window Controls (Standard system frame used, top bar shows logo) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="LogoImage" Source="pack://application:,,,/Assets/Logo/logo.png" Height="60" MaxWidth="200" Stretch="Uniform"/>
            </StackPanel>

            <!-- Center Content Area: Play Button and Secondary Buttons -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
                
                <!-- Main Play Button -->
                <Button x:Name="BtnPlay" Style="{StaticResource PlayButtonStyle}" Click="BtnPlay_Click" Margin="0,0,0,20"/>

                <!-- Secondary Buttons Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnFolder" Style="{StaticResource SecondaryButtonStyle}" Click="BtnFolder_Click" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Icons/folder.png" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock Text="Открыть папку" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="BtnSite" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSite_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Icons/globe.png" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock Text="Сайт проекта" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Footer: Status and Version -->
            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Статус: Готово к запуску" Foreground="#DDDDDD" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TxtVersion" Grid.Column="1" Text="Версия: 0.1.0" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
